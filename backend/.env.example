# Application
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=info

# CORS Allowed Origins (comma-separated or single URL)
CORS_ORIGIN=http://localhost:5173

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/virtualtrade

# Security & Session Authentication
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_of_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Market Data Engine (mock | delayed | live)
MARKET_DATA_PROVIDER=mock
